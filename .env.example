# MLflow server URL (tracking)
mlflow_url=http://localhost:5000/

# MLflow AI Gateway - endpoint compativel com OpenAI
mlflow_openia_url=http://localhost:5000/gateway/mlflow/v1

# Modelo configurado no AI Gateway (usado para inferencia)
mlflow_model=gemma4-e4b

# Modelo para LLM judges (avaliacao/scoring)
# Pode ser diferente do modelo de inferencia — ex: modelo maior para avaliar melhor
mlflow_judge_model=gemma4-e4b

# Azure OpenAI — usado para prompt optimization (Demo 10, opcional)
# AZURE_OPENAI_API_KEY=<sua-key>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
